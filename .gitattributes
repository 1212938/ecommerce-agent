# 统一行尾为 LF，避免 Windows/Linux 协作时的 CRLF 差异
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# 二进制文件不做行尾转换
*.index binary
*.npy binary
*.pkl binary
*.faiss binary
*.safetensors binary
*.tar.gz binary
*.whl binary
*.pdf binary
